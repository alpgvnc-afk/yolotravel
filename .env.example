# Claude API anahtarı — https://console.anthropic.com/ adresinden alabilirsiniz
# UYARI: VITE_ prefix'li env değişkenleri client bundle'a dahil edilir,
# yani üretimde API key tarayıcıdan görünür olur. Production için bir backend proxy kullanın.
VITE_CLAUDE_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Maps JS API
VITE_GOOGLE_MAPS_KEY=AIzaSy-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# RapidAPI (server-side only)
RAPIDAPI_KEY=your-rapidapi-key

# Supabase — shareable plans backend
# Get these from https://app.supabase.com → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-key-here
